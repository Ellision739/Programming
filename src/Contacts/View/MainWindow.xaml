<Window x:Name="MainForm" x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="Contacts" Height="375" Width="500">
    <Grid x:Name="MainGrid" Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GroupBox Header="Edit Contact" Margin="3">
            <StackPanel x:Name="EditStackPanel">
                <TextBlock 
                    TextWrapping="Wrap" 
                    Text="Name:" 
                    Margin="3"/>
                <TextBox  
                    TextWrapping="Wrap" 
                    Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                    Margin="3" Height="18"/>
                <TextBlock 
                    TextWrapping="Wrap" 
                    Text="Phone Number:" 
                    Margin="3"/>
                <TextBox 
                    TextWrapping="Wrap" 
                    Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                    Margin="3" Height="18"/>
                <TextBlock 
                    TextWrapping="Wrap" 
                    Text="Email:" 
                    Margin="3"/>
                <TextBox 
                    TextWrapping="Wrap" 
                    Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="18"/>
            </StackPanel>
        </GroupBox>
        <GroupBox 
            Grid.Column="1" 
            Header="Read Contact" 
            Margin="3">
            <StackPanel>
                <TextBlock 
                    TextWrapping="Wrap" 
                    Text="Name:" 
                    Margin="3"/>
                <Label 
                    Content="{Binding Name}"
                    FontWeight="Bold"
                    Padding="0"
                    Height="18" 
                    VerticalAlignment="Top"
                    Margin="3"/>
                <TextBlock 
                    TextWrapping="Wrap" 
                    Text="Phone Number:" 
                    Margin="3"/>
                <Label 
                    Content="{Binding Phone}" 
                    Margin="3" 
                    Padding="0"
                    FontWeight="Bold" Height="18"/>
                <TextBlock 
                    TextWrapping="Wrap" 
                    Text="Email:" 
                    Margin="3"/>
                <Label 
                    Content="{Binding Email}"
                    Margin="3"
                    Padding="0"
                    FontWeight="Bold" Height="18"/>
            </StackPanel>
        </GroupBox>
        <StackPanel 
            Grid.Column="1" 
            Grid.Row="1"
            Orientation="Horizontal" 
            HorizontalAlignment="Right" 
            Margin="0 10 0 0">
            <Button
                Content="Save"
                Width="75" 
                Height="25"
                Margin="3"
                Command="{Binding SaveCommand}"/>
            <Button 
                Content="Load"
                Width="75" 
                Height="25"
                Margin="3" 
                Command="{Binding LoadCommand}"/>
        </StackPanel>
    </Grid>
</Window>
