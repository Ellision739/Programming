<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        xmlns:controls="clr-namespace:View.Controls"
        mc:Ignorable="d"
        Title="Contacts" 
        Height="450" 
        Width="800" 
        Icon="/contacts_64x64.ico">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <DataTemplate x:Key="contactTemplate">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" 
               Source="/contacts_512px.png" 
               Width="32" 
               Height="32" 
               Margin="0 0 10 0"
               VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Text="{Binding Name}"/>
                    <TextBlock
                FontSize="10"
                Text="{Binding Phone}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid Background="#f8f8f8" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ListBox 
                Grid.Row="1" 
                Margin="3"
                ItemsSource="{Binding Contacts}"
                SelectedItem="{Binding SelectedContact}"
                ItemTemplate="{StaticResource contactTemplate}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock 
                    HorizontalAlignment="Left" 
                    TextWrapping="Wrap" 
                    Text="Find:" 
                    Margin="3"/>
                <TextBox 
                    Grid.Column="1" 
                    TextWrapping="Wrap" 
                    Margin="3"/>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button 
                    Content="Add" 
                    Margin="3" 
                    Height="25"
                    Command="{Binding AddCommand}"
                    IsEnabled="{Binding IsButtonEnabled}"/>
                <Button 
                    Grid.Column="1" 
                    Content="Edit" 
                    Margin="3" 
                    Height="25"
                    Command="{Binding EditCommand}"
                    IsEnabled="{Binding IsButtonEnabled}"/>
                <Button 
                    Grid.Column="2" 
                    Content="Remove"
                    Margin="3" 
                    Height="25"
                    Command="{Binding RemoveCommand}"
                    IsEnabled="{Binding IsButtonEnabled}"/>
            </Grid>
        </Grid>
        <GridSplitter 
            HorizontalAlignment="Center" 
            Width="5" 
            Grid.Column="1" 
            Background="White"/>
        <Grid Grid.Column="2" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <controls:ContactControl Grid.Row="0" DataContext="{Binding SelectedContact}"/>
            <Button 
                Grid.Row="1"
                Content="Apply" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Top"
                Width="75" 
                Height="25" 
                Margin="113 10 0 0" 
                Command="{Binding ApplyCommand}"
                Visibility="{Binding IsApplyVisible, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </Grid>
</Window>